{
  "compilerOptions": {
    "types": [
      "bun",
      "node"
    ],

    "strict": true,
    "skipLibCheck": true,

    "lib": [
      "ESNext",
      "DOM",
    ],
    "target": "esnext",
    "module": "nodenext",

    "moduleResolution": "nodenext",
    "resolveJsonModule": true
  },
  "include": [
    "./src/**/*",
  ]
}
